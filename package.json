{
  "name": "country-road-simulator",
  "version": "1.0.0",
  "description": "Narrow lanes, high hedges, tractors and sheep: a considerate-driving game set on the country roads of England, Wales and Scotland.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --alias:three=./vendor/three.module.js --minify --sourcemap --outfile=dist/country-road.js",
    "start": "npm run build && node server.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
